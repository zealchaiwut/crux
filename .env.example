# Neon Postgres connection string
# Obtain from neon.tech → your project → Connection Details → copy the connection string
# Format: postgresql://user:password@ep-xxxx-xxxx.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.region.neon.tech/neondb?sslmode=require

# Application settings
PORT=8000
ENV=development

# Auth — required, must be at least 16 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=changeme_generate_a_real_secret_before_deploy

# Authentication gate — ON by default. Set to 0 to disable for local single-user use (opt-out).
CRUX_REQUIRE_AUTH=1

# Service-to-service Bearer token — full read+write access.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Rotate: generate a new token, update the caller's env var and this value, then restart both services.
# CRUX_SERVICE_TOKEN=

# Verdict-scoped token — grants POST /api/cases/{id}/verdict only (no general write access).
# Use for callers that only need to submit verdicts (e.g. viral-radar settling content-post verdicts).
# Generate and rotate the same way as CRUX_SERVICE_TOKEN above.
# CRUX_VERDICT_TOKEN=

# Anthropic API key — OPTIONAL. By default crux calls Claude via the `claude` CLI
# (subscription, no key). Only needed if you switch the provider to "Anthropic API"
# in the in-app Settings modal, where usage is capped by a USD budget.
# ANTHROPIC_API_KEY=sk-ant-...

# Tavily search API key — OPTIONAL but recommended for source suggestions.
# When set, "Suggest sources" searches Tavily for real, content-backed URLs and
# only returns ones that verify against the plan. Without it, crux falls back to
# LLM-guessed URLs + direct-fetch verification. Get a key at https://tavily.com
# TAVILY_API_KEY=tvly-...

# LLM provider selection — OPTIONAL (default: unset, uses in-app settings toggle).
# Set to one of: groq | anthropic_api | claude_cli
# CRUX_LLM_PROVIDER=groq

# Groq API key — REQUIRED when CRUX_LLM_PROVIDER=groq.
# Obtain from console.groq.com → API Keys.
# GROQ_API_KEY=gsk_...

# Groq model overrides — only applied when CRUX_LLM_PROVIDER=groq.
# CRUX_JUDGMENT_MODEL=openai/gpt-oss-120b
# CRUX_BULK_MODEL=llama-3.1-8b-instant
